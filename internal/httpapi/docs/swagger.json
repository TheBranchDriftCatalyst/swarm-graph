{
    "swagger": "2.0",
    "info": {
        "description": "API for rendering swarm graphs and inspecting docker resources.",
        "title": "Swarm Graph API",
        "contact": {
            "name": "Catalyst Dev",
            "email": "dev@example.com"
        },
        "version": "0.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/docker/inspect": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Inspect Docker resource",
                "parameters": [
                    {
                        "type": "string",
                        "description": "docker resource id or name",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/graph.json": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Graph JSON snapshot",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/graph.mmd": {
            "get": {
                "description": "Return raw Mermaid diagram source (text/plain) with optional query filters",
                "produces": [
                    "text/plain"
                ],
                "summary": "Mermaid source",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by stack attribute",
                        "name": "stack",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Exclude nodes with zero degree (1/true)",
                        "name": "exclude_orphans",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated kinds to include (container,image,network,volume)",
                        "name": "kinds",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Layout direction (LR, RL, TB, BT)",
                        "name": "dir",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Name substring filter (case-insensitive)",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Minimum incident edges to include node",
                        "name": "min_degree",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated kinds to exclude",
                        "name": "exclude_kinds",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Append short IDs to labels (1/true)",
                        "name": "show_ids",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Truncate labels to this many runes (0 disables)",
                        "name": "max_label_runes",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Group nodes by this attribute into subgraphs",
                        "name": "group_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Theme name (synthwave/cyberpunk/neon)",
                        "name": "theme",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Include legend in output (1/true)",
                        "name": "include_legend",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/graph.png": {
            "get": {
                "produces": [
                    "image/png"
                ],
                "summary": "Rendered PNG",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        },
        "/graph.svg": {
            "get": {
                "produces": [
                    "image/svg+xml"
                ],
                "summary": "Rendered SVG",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by stack",
                        "name": "stack",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated kinds",
                        "name": "kinds",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Layout direction",
                        "name": "dir",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}